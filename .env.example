# Neon Postgres connection string (pooled connection recommended). Get this
# from your Neon project dashboard -> Connection Details. Used by
# src/lib/db/client.ts (drizzle-orm/neon-http) — server-only, never exposed
# to the browser.
DATABASE_URL=

# Clerk (real accounts only; guests use the hand-rolled guest_id cookie
# instead, see src/lib/identity/guest-cookie.ts). Get both from your Clerk
# application dashboard -> API Keys. The publishable key is safe to expose
# to the browser (that's what NEXT_PUBLIC_ means); the secret key is
# server-only, used by src/middleware.ts and src/lib/identity/get-current-actor.ts.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Ably (realtime room/match sync). Get this from your Ably app -> API Keys
# — use a key with subscribe/publish/presence capabilities. Server-only:
# src/lib/realtime/ably-server.ts uses it to mint short-lived, room-scoped
# tokens (see GET /api/ably-token) and to publish state updates; it must
# never reach the browser. The client SDK (src/lib/realtime/use-realtime-room.ts)
# never sees this key, only the tokens minted from it.
ABLY_API_KEY=

# Optional. Protects /api/cron/cleanup (scheduled in vercel.json, reclaims
# idle rooms) so only Vercel's own cron requests can trigger it — Vercel
# attaches this automatically as a Bearer header when the env var is set.
# Without it, the route runs unauthenticated (fine for local dev, not
# recommended in production).
CRON_SECRET=
